                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/latex/apply": {
      "post": {
        "tags": [
          "latex"
        ],
        "summary": "Apply Latex",
        "description": "Write the tailored text into the user's LaTeX, layout untouched, and by\ndefault keep it on one page by trimming the least relevant bullets.",
        "operationId": "apply_latex_api_v1_latex_apply_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LatexApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
