    "/api/v1/resumes/parse": {
      "post": {
        "tags": [
          "resume"
        ],
        "summary": "Parse",
        "description": "Validate an uploaded PDF/DOCX and extract its text. Nothing is stored.",
        "operationId": "parse_api_v1_resumes_parse_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_parse_api_v1_resumes_parse_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParsedFile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/latex/parse": {
      "post": {
        "tags": [
          "latex"
        ],
        "summary": "Parse Latex",
        "description": "Read a pasted LaTeX resume into the same shape as an uploaded file.",
        "operationId": "parse_latex_api_v1_latex_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LatexSource"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
