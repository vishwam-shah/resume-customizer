              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/latex/compile": {
      "post": {
        "tags": [
          "latex"
        ],
        "summary": "Compile Source",
        "description": "Compile LaTeX to PDF (or a PNG of page 1 for previews). X-Pages has the page count.",
        "operationId": "compile_source_api_v1_latex_compile_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LatexCompileRequest"
