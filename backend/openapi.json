              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tailor": {
      "post": {
        "tags": [
          "tailor"
        ],
        "summary": "Tailor",
        "description": "Tailor a resume to a job. Streams `stage`, `resume`, `analysis`,\n`scoresBefore`, `result`, `done` and `error` events.",
        "operationId": "tailor_api_v1_tailor_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TailorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cover-letter": {
      "post": {
        "tags": [
          "coverLetter"
        ],
        "summary": "Cover Letter",
        "description": "Streams `token` events with text chunks, then `done` (or `error`).",
        "operationId": "cover_letter_api_v1_cover_letter_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
